# TerraRisk Workshop - Production Environment Variables

# Backend FastAPI
PYTHONUNBUFFERED=1
ENVIRONMENT=production

# Frontend Next.js
# API URL interna (comunicación container-to-container)
NEXT_PUBLIC_API_URL=http://api:8000

# Node environment
NODE_ENV=production

# Optional: Si necesitas autenticación en el futuro
# API_SECRET_KEY=your-secret-key-here
# JWT_SECRET=your-jwt-secret-here

# Database (si se agrega PostgreSQL/SQLite path en el futuro)
# DATABASE_URL=sqlite:///./data/terrarisk.db
